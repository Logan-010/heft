cabal-version:      3.0
name:               heft
version:            0.1.0.0
synopsis:           Personal financial tracking service
homepage:           https://github.com/Logan-010/heft
license:            MIT
license-file:       LICENSE
author:             Logan-010
maintainer:         loganbreezestl@gmail.com
category:           Finance
build-type:         Simple
extra-source-files:
  frontend/dist/elm.js
  frontend/dist/icon.png
  frontend/dist/index.html
  frontend/dist/style.css

common warnings
  ghc-options: -Wall -threaded

executable heft
  import:           warnings
  main-is:          Main.hs
  other-modules:
    Cli
    Database
    Database.Auth
    Database.Finance.Accounts
    Database.Finance.Transactions
    Database.Migrate
    Database.Ledger
    Http
    Http.Auth
    Http.Finance.Accounts
    Http.Finance.Transactions
    Http.Ledger
    Http.Router
    Logger

  -- other-extensions:
  build-depends:
    , aeson
    , base           ==4.20.2.0
    , bytestring
    , cookie
    , crypton
    , fast-logger
    , file-embed
    , http-types
    , password       ==3.1.1.0
    , sqlite-simple
    , text
    , time
    , wai
    , warp
    , warp-tls
    , hledger-lib

  hs-source-dirs:   app
  default-language: Haskell2010

test-suite ledger-tests
  type:             exitcode-stdio-1.0
  main-is:          LedgerTest.hs
  hs-source-dirs:   test, app
  other-modules:
    Database.Ledger
    Database.Migrate
  ghc-options:      -Wall
  build-depends:
    , base ==4.20.2.0
    , hledger-lib
    , sqlite-simple
    , text
    , time
  default-language: Haskell2010
