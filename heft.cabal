cabal-version: 3.0
name:          heft
version:       0.1.0.0
synopsis:      Personal financial tracking service

-- description:
homepage:      https://github.com/Logan-010/heft
license:       MIT
license-file:  LICENSE
author:        Logan-010
maintainer:    loganbreezestl@gmail.com

-- copyright:
category:      Finance
build-type:    Simple

extra-source-files:
  frontend/dist/index.html
  frontend/dist/elm.js
  frontend/dist/style.css
  frontend/dist/icon.png

common warnings
  ghc-options: -Wall -threaded

executable heft
  import:           warnings
  main-is:          Main.hs
  other-modules:
    Cli
    Database
    Database.Migrate
    Http
    Http.Router
    Logger

  -- other-extensions:
  build-depends:
    , base           ^>=4.20.2.0
    , bytestring
    , fast-logger
    , http-types
    , sqlite-simple
    , text
    , time
    , wai
    , warp
    , warp-tls
    , file-embed

  hs-source-dirs:   app
  default-language: Haskell2010
